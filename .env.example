# Copie este archivo como .env solo si necesita cambiar algún valor.
# Sin .env el laboratorio usa estos mismos valores por defecto.

# Dirección donde se publican los puertos 8080 y 8000.
# Por defecto solo este equipo (127.0.0.1).
# Nunca use 0.0.0.0 ni una red pública, la aplicación es vulnerable a propósito.
BIND_ADDRESS=127.0.0.1

# Servidor local de Jan
LLM_BASE_URL=http://host.docker.internal:1337/v1
# No se usa clave de API, se deja vacía.
LLM_API_KEY=
# Copie los nombres exactos que muestra http://127.0.0.1:1337/v1/models
# En Mac con la versión MLX el modelo de chat se llama Qwen3-4B-Instruct-2507-4bit
# (descarga en Jan desde https://huggingface.co/mlx-community/Qwen3-4B-Instruct-2507-4bit)
LLM_CHAT_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_EMBED_MODEL=nomic-embed-text-v2-moe.Q8_0.gguf
EMBED_DIM=768
LLM_TIMEOUT_S=120
